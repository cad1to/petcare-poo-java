            +Mascota(String nombre, int edad, double peso, Dueno dueno)
            +hacerSonido()* String
            +setEdad(int edad) void
            +setPeso(double peso) void
            +getDueno() Dueno
            +getHistorial() HistorialClinico
            +toString() String
        }
        class Perro {
            -String raza
            -String nivelEnergia
            +Perro()
            +Perro(String nombre, int edad, double peso, Dueno dueno, String raza, String nivelEnergia)
            +hacerSonido() String
        }
        class Gato {
            -boolean esDomestico
            +Gato(String nombre, int edad, double peso, Dueno dueno, boolean esDomestico)
            +hacerSonido() String
        }
        class Ave {
            -double longitudAlas
            +Ave(String nombre, int edad, double peso, Dueno dueno, double longitudAlas)
            +hacerSonido() String
        }
        class HistorialClinico {
            -List~Cita~ citasAtendidas
            +HistorialClinico()
            +agregarCita(Cita cita) void
            +listarCitas() List~Cita~
        }
    }

