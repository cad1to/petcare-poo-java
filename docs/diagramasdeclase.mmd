    namespace modelo_clinica {
        class Clinica {
            -String nombre
            -List~Veterinario~ veterinarios
            -List~Consultorio~ consultorios
            -List~Cita~ citas
            -List~Mascota~ mascotas
            -List~Dueno~ duenos
            -List~Comprobante~ comprobantes
            +Clinica(String nombre, int cantidadConsultorios)
            +agregarVeterinario(Veterinario veterinario) void
            +registrarDueno(Dueno dueno) void
            +registrarMascota(Mascota mascota) void
            +agendarCita(Mascota mascota, Veterinario veterinario, Consultorio consultorio, LocalDateTime fechaHora) Cita
            +buscarCita(String nombreMascota) List~Cita~
            +buscarCita(LocalDate fecha) List~Cita~
            +darDeBajaMascota(Mascota mascota) void
            +totalCobradoPorVeterinario(Veterinario veterinario) double
            +totalCobradoPorMascota(Mascota mascota) double
        }
        class Consultorio {
            -int numero
            +Consultorio(int numero)
            +getNumero() int
            +toString() String
        }
        class Cita {
            -LocalDateTime fechaHora
            -EstadoCita estado
            -Mascota mascota
            -Veterinario veterinario
            -Consultorio consultorio
            -Servicio servicio
            +Cita(LocalDateTime fechaHora, Mascota mascota, Veterinario veterinario, Consultorio consultorio)
            +atender(Servicio servicio) void
            +cancelar() void
            +generarComprobante() Comprobante
            +getEstado() EstadoCita
            +toString() String
        }
        class EstadoCita {
            <<enumeration>>
            PROGRAMADA
            ATENDIDA
            CANCELADA
        }
    }

